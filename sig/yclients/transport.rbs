module Yclients
  module Transport
    class Faraday
      def self.request_limiter: () -> _RequestLimiter?
      def self.request_limiter=: (_RequestLimiter? limiter) -> _RequestLimiter?
      def initialize: (Configuration configuration) -> void
      def request: (Symbol method, String path, ?params: parameters, ?body: request_value) -> Response
      def inspect: () -> String
    end
  end

  module Serialization
    def self.normalize: (request_value value) -> request_value
  end
end
